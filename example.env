# --- Required ---

# Discord bot token
DISCORD_TOKEN=
# Password for the Postgres container. Letters and digits only: it is placed in a connection URL.
POSTGRES_PASSWORD=

# --- Optional (leave empty to use the default or disable the feature) ---

# Display name used in embeds. Default: gulp-bot
BOT_NAME=
# TRACE, DEBUG, INFO, WARN or ERROR. Default: INFO
LOG_LEVEL=
# Most questions the AI assistant answers in 24 hours, from everybody together, whatever model answers.
# Default: 100
AI_DAILY_LIMIT=
# Which model answers. The stack only passes the settings of a local model: set it to local (Ollama on
# your own GPU, nothing leaves the machine), or use docker-compose.ollama.yml, which does. Left empty, the
# bot looks for Claude, finds no API key and keeps the assistant off.
AI_BACKEND=
# Ollama server, for AI_BACKEND=local. Default: http://ollama:11434
LOCAL_MODEL_URL=
# Model Ollama runs, for AI_BACKEND=local. Default: qwen3.5:9b
LOCAL_MODEL=
# Whether the local model thinks before answering: false, true, or default (send nothing). Default: false
LOCAL_MODEL_THINK=
# File with what the AI assistant knows about the guild. Default: ext_resources/system_prompt.md (in the
# image, /app/ext_resources/system_prompt.md). To edit it without rebuilding, mount your own file into the container
# and point this at it.
SYSTEM_PROMPT_PATH=
# Image version to run, e.g. v2026.10.09-c97a8ec (see build-image.sh). Default: latest
IMAGE_TAG=
# Ollama release to run, only with docker-compose.ollama.yml (a model on this host's GPU): a tag from
# hub.docker.com/r/ollama/ollama/tags. Required there; that file sets AI_BACKEND=local itself.
OLLAMA_VERSION=
