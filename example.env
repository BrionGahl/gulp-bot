# --- Required ---

# Discord bot token
DISCORD_TOKEN=
# Password for the Postgres container. Letters and digits only: it is placed in a connection URL.
POSTGRES_PASSWORD=

# --- Optional (leave empty to use the default or disable the feature) ---

# Display name used in embeds. Default: gulp-bot
BOT_NAME=
# TRACE, DEBUG, INFO, WARN or ERROR. Default: INFO
LOG_LEVEL=
