# --- Required ---

# Discord bot token
DISCORD_TOKEN=
# Password for the Postgres container. Letters and digits only: it is placed in a connection URL.
POSTGRES_PASSWORD=

# --- Optional (leave empty to use the default or disable the feature; the values filled in are the defaults) ---

# Display name used in embeds. Default: gulp-bot
BOT_NAME=
# TRACE, DEBUG, INFO, WARN or ERROR. Default: INFO
LOG_LEVEL=
# Most questions the AI assistant answers in 24 hours, from everybody together, whatever model answers.
AI_DAILY_LIMIT=100
# Which model answers: local, a model on your own hardware through Ollama, so nothing members write leaves
# your machines. docker-compose.ollama.yml runs Ollama next to the bot; without it (or another Ollama server
# at LOCAL_MODEL_URL) the assistant can't answer.
AI_BACKEND=local
# Ollama server. The default is the one docker-compose.ollama.yml runs.
LOCAL_MODEL_URL=http://ollama:11434
# Model Ollama runs. Fits a 12 GB GPU (see the README, "Requirements").
LOCAL_MODEL=qwen3.5:9b
# Whether the local model thinks before answering: false, true, or default (send nothing). /ai think
# changes it per server.
LOCAL_MODEL_THINK=false
# File with what the AI assistant knows about the guild. Default: ext_resources/system_prompt.md (in the
# image, /app/ext_resources/system_prompt.md). To edit it without rebuilding, mount your own file into the container
# and point this at it.
SYSTEM_PROMPT_PATH=
# Image version to run, e.g. v2026.10.09-c97a8ec (see build-image.sh). Default: latest
IMAGE_TAG=
# Ollama release to run, only with docker-compose.ollama.yml (a model on this host's GPU): a tag from
# hub.docker.com/r/ollama/ollama/tags. Required there; that file sets AI_BACKEND=local itself.
OLLAMA_VERSION=
