# --- Required ---

# Discord bot token
DISCORD_TOKEN=
# Password for the Postgres container. Letters and digits only: it is placed in a connection URL.
POSTGRES_PASSWORD=

# --- Optional (leave empty to use the default or disable the feature) ---

# Display name used in embeds. Default: gulp-bot
BOT_NAME=
# TRACE, DEBUG, INFO, WARN or ERROR. Default: INFO
LOG_LEVEL=
# Anthropic API key (console.anthropic.com) for the AI assistant: `/ask` and messages that say
# "Bot please". Without it the assistant is off.
ANTHROPIC_API_KEY=
# Claude model that answers. Default: claude-sonnet-5-5
ANTHROPIC_MODEL=
# How much effort the model puts into an answer: low, medium, high... Default: low. "off" doesn't send it.
ANTHROPIC_EFFORT=
# Most questions the assistant answers in 24 hours, from everybody together; caps the bill. Default: 100
ANTHROPIC_DAILY_LIMIT=
# Image version to run, e.g. v2026.10.09-c97a8ec (see build-image.sh). Default: latest
IMAGE_TAG=
